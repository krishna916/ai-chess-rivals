# Database configuration
POSTGRES_DB=<database-name>
POSTGRES_USER=<database-username>
POSTGRES_PASSWORD=<database-password>

# Spring datasource configuration
SPRING_DATASOURCE_URL=<jdbc-database-url>
SPRING_DATASOURCE_USERNAME=<database-username>
SPRING_DATASOURCE_PASSWORD=<database-password>

# Flyway migration configuration
SPRING_FLYWAY_URL=<jdbc-database-url>
SPRING_FLYWAY_USER=<database-username>
SPRING_FLYWAY_PASSWORD=<database-password>

# Production safety
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Stockfish runtime configuration
STOCKFISH_PATH=stockfish/stockfish
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=16
STOCKFISH_STARTUP_TIMEOUT_SECONDS=10
STOCKFISH_MOVE_TIMEOUT_SECONDS=30
STOCKFISH_EVALUATION_DEPTH=8
STOCKFISH_EVALUATION_MOVE_TIME_MILLIS=50
STOCKFISH_MAJOR_GAIN_THRESHOLD_CP=200
STOCKFISH_MAJOR_MISTAKE_THRESHOLD_CP=200

# Match engine configuration
GAME_MOVE_THINK_TIME_MILLIS=250
GAME_MAX_PLIES=300
GAME_MOVE_DELAY_MIN=7s
GAME_MOVE_DELAY_MAX=12s

# Owner-only match controls and in-memory execution guard
OWNER_CONTROL_TOKEN=<generate-a-random-32-byte-token>
MATCH_COOLDOWN=60s
MATCH_DAILY_START_LIMIT=12

# Match websocket configuration
APP_WEBSOCKET_ALLOWED_ORIGIN=http://localhost:5173

# Phase 2 AI provider configuration.
# JVM/local execution stays disabled unless explicitly enabled.
# Docker Compose also uses AI_ENABLED to select the native AOT bean topology at build time,
# so changing AI_ENABLED for the container requires rebuilding the backend image.
AI_ENABLED=false
# Phase 2 OpenRouter provider configuration.
# Select one specific :free model for consistent character voice; do not use openrouter/free.
AI_OPENROUTER_API_KEY=<openrouter-api-key>
AI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_OPENROUTER_PRIMARY_MODEL=inclusionai/ling-3.0-flash:free
AI_OPENROUTER_FALLBACK_MODEL=~deepseek/deepseek-v4-flash-latest
AI_OPENROUTER_PRIMARY_TIMEOUT=8s
AI_OPENROUTER_FALLBACK_TIMEOUT=12s
